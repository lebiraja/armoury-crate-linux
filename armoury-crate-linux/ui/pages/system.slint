// System control page - Platform profiles, battery, power controls
// Redesigned with glassmorphism and extended power modes

import { RogTheme } from "../theme.slint";
import { GlassCard, GlassToggle, SectionHeader } from "../widgets/glass_card.slint";
import { Slider } from "std-widgets.slint";

// System page data bindings
export global SystemPageData {
    // Platform profile (0=Balanced, 1=Performance, 2=Quiet)
    // Extended: 3=Turbo, 4=Manual
    in-out property <int> platform_profile: 0;
    in-out property <[string]> platform_profile_choices: ["Balanced", "Performance", "Quiet", "Turbo", "Manual"];
    callback cb_platform_profile(int);

    // Charge control
    in-out property <bool> charge_control_enabled: false;
    in-out property <float> charge_control_end_threshold: 100;
    callback cb_charge_control_end_threshold(int);

    // Panel settings
    in-out property <bool> panel_od: false;
    callback cb_panel_od(bool);

    in-out property <int> mini_led_mode: 0;
    callback cb_mini_led_mode(int);

    // GPU MUX
    in-out property <int> gpu_mux_mode: 0;
    callback cb_gpu_mux_mode(int);

    // PPT/TDP settings (min/max/current) for Manual mode
    in-out property <int> ppt_pl1_spl_min: 5;
    in-out property <int> ppt_pl1_spl_max: 80;
    in-out property <float> ppt_pl1_spl: 30;

    in-out property <int> ppt_pl2_sppt_min: 5;
    in-out property <int> ppt_pl2_sppt_max: 120;
    in-out property <float> ppt_pl2_sppt: 45;

    callback cb_ppt_pl1_spl(int);
    callback cb_ppt_pl2_sppt(int);

    // Fan curve selection for Manual mode
    in-out property <int> fan_profile_mode: 0; // 0=Default, 1=Custom
    callback cb_fan_profile_mode(int);
}

// Gaming-styled slider with glass effect
component GamingSlider inherits Rectangle {
    in property <string> label;
    in property <string> unit: "";
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 50;
    callback changed(int);

    height: 72px;
    background: RogTheme.glass-bg;
    border-radius: RogTheme.glass-radius;
    border-width: 1px;
    border-color: RogTheme.glass-border;

    VerticalLayout {
        padding: RogTheme.spacing-md;
        spacing: RogTheme.spacing-sm;

        HorizontalLayout {
            Text {
                text: label;
                font-size: RogTheme.font-size-body;
                color: RogTheme.text-secondary;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: round(value) + unit;
                font-size: RogTheme.font-size-body;
                font-weight: 700;
                color: RogTheme.accent-cyan;
                vertical-alignment: center;
            }
        }

        // Custom Slider implementation since std-widgets Slider is hard to style perfectly
        Rectangle {
            height: 24px; // Hit area

            // Track
            Rectangle {
                height: 4px;
                y: 10px;
                border-radius: 2px;
                background: RogTheme.bg-tertiary;

                // Filled portion
                Rectangle {
                    x: 0;
                    width: parent.width * clamp((value - minimum) / (maximum - minimum), 0, 1);
                    height: 100%;
                    border-radius: parent.border-radius;
                    background: RogTheme.accent-cyan;
                }
            }

            // Handle
            Rectangle {
                x: parent.width * clamp((value - minimum) / (maximum - minimum), 0, 1) - self.width / 2;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: RogTheme.accent-cyan;
                border-width: 2px;
                border-color: white;

                drop-shadow-color: RogTheme.accent-cyan.with-alpha(0.5);
                drop-shadow-blur: 8px;
            }

            TouchArea {
                moved => {
                    value = clamp(
                        minimum + (self.mouse-x / parent.width) * (maximum - minimum),
                        minimum,
                        maximum
                    );
                    changed(round(value));
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up {
                        changed(round(value));
                    }
                }
            }
        }
    }
}

// Profile button for platform profile selection
component ProfileButton inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <bool> selected: false;
    in property <color> accent-color: RogTheme.accent-red;

    callback clicked();

    width: 100px;
    height: 70px;
    background: selected ? accent-color.with-alpha(0.2) : RogTheme.glass-bg;
    border-radius: RogTheme.radius-md;
    border-width: selected ? 2px : 1px;
    border-color: selected ? accent-color : RogTheme.glass-border;

    states [
        hover when touch.has-hover && !selected: {
            border-color: accent-color.with-alpha(0.5);
            background: RogTheme.glass-bg-light;
        }
    ]

    animate background, border-color { duration: RogTheme.anim-fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        Text {
            text: icon;
            font-size: 20px;
            color: selected ? accent-color : RogTheme.text-secondary;
            horizontal-alignment: center;
        }

        Text {
            text: label;
            font-size: RogTheme.font-size-xs;
            font-weight: selected ? 700 : 400;
            color: selected ? accent-color : RogTheme.text-primary;
            horizontal-alignment: center;
        }
    }
}

// Main system page
export component PageSystem inherits Rectangle {
    background: transparent;

    Flickable {
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            padding: RogTheme.spacing-lg;
            spacing: RogTheme.spacing-lg;

            // Header
            Text {
                text: "System Control";
                font-size: RogTheme.font-size-h1;
                font-weight: 700;
                color: RogTheme.text-primary;
            }

            // Platform Profile Section
            GlassCard {
                title: "Operating Mode";
                accent-color: RogTheme.accent-red;

                VerticalLayout {
                    spacing: RogTheme.spacing-md;

                    Text {
                        text: "Select a performance profile based on your usage";
                        font-size: RogTheme.font-size-sm;
                        color: RogTheme.text-secondary;
                    }

                    HorizontalLayout {
                        spacing: RogTheme.spacing-sm;
                        alignment: center;

                        ProfileButton {
                            label: "Quiet";
                            icon: "🔇";
                            selected: SystemPageData.platform_profile == 2;
                            accent-color: RogTheme.accent-cyan; // Blue/Cool for quiet
                            clicked => { SystemPageData.cb_platform_profile(2); }
                        }

                        ProfileButton {
                            label: "Balanced";
                            icon: "⚖️";
                            selected: SystemPageData.platform_profile == 0;
                            accent-color: RogTheme.text-primary; // Neutral for balanced
                            clicked => { SystemPageData.cb_platform_profile(0); }
                        }

                        ProfileButton {
                            label: "Performance";
                            icon: "🚀";
                            selected: SystemPageData.platform_profile == 1;
                            accent-color: RogTheme.accent-orange; // Orange/Warm for performance
                            clicked => { SystemPageData.cb_platform_profile(1); }
                        }

                        ProfileButton {
                            label: "Turbo";
                            icon: "🔥";
                            selected: SystemPageData.platform_profile == 3;
                            accent-color: RogTheme.accent-red; // Red/Hot for Turbo
                            clicked => { SystemPageData.cb_platform_profile(3); }
                        }

                        ProfileButton {
                            label: "Manual";
                            icon: "⚙️";
                            selected: SystemPageData.platform_profile == 4;
                            accent-color: RogTheme.accent-purple; // Purple for custom
                            clicked => { SystemPageData.cb_platform_profile(4); }
                        }
                    }

                    // Manual Mode Controls (Only visible when Manual is selected)
                    if SystemPageData.platform_profile == 4: Rectangle {
                        background: RogTheme.bg-tertiary.with-alpha(0.3);
                        border-radius: RogTheme.radius-md;
                        border-width: 1px;
                        border-color: RogTheme.glass-border;

                        VerticalLayout {
                            padding: RogTheme.spacing-md;
                            spacing: RogTheme.spacing-md;

                            Text {
                                text: "Manual Configuration";
                                font-size: RogTheme.font-size-body;
                                font-weight: 600;
                                color: RogTheme.accent-purple;
                            }

                            GamingSlider {
                                label: "SPL (Sustained Power Limit)";
                                unit: "W";
                                minimum: SystemPageData.ppt_pl1_spl_min * 1.0;
                                maximum: SystemPageData.ppt_pl1_spl_max * 1.0;
                                value: SystemPageData.ppt_pl1_spl;
                                changed(val) => { SystemPageData.cb_ppt_pl1_spl(val); }
                            }

                            GamingSlider {
                                label: "SPPT (Slow Package Power Tracking)";
                                unit: "W";
                                minimum: SystemPageData.ppt_pl2_sppt_min * 1.0;
                                maximum: SystemPageData.ppt_pl2_sppt_max * 1.0;
                                value: SystemPageData.ppt_pl2_sppt;
                                changed(val) => { SystemPageData.cb_ppt_pl2_sppt(val); }
                            }
                        }
                    }
                }
            }

            // GPU Mode
            GlassCard {
                title: "GPU Mode";
                accent-color: RogTheme.accent-purple;

                VerticalLayout {
                    spacing: RogTheme.spacing-md;

                    Text {
                        text: "Switch between hybrid and discrete GPU mode (requires reboot)";
                        font-size: RogTheme.font-size-sm;
                        color: RogTheme.text-secondary;
                    }

                    HorizontalLayout {
                        spacing: RogTheme.spacing-md;
                        alignment: start;

                        ProfileButton {
                            label: "Hybrid";
                            icon: "🔋";
                            selected: SystemPageData.gpu_mux_mode == 0;
                            accent-color: RogTheme.accent-green;
                            clicked => { SystemPageData.cb_gpu_mux_mode(0); }
                        }

                        ProfileButton {
                            label: "Discrete";
                            icon: "🎮";
                            selected: SystemPageData.gpu_mux_mode == 1;
                            accent-color: RogTheme.accent-purple;
                            clicked => { SystemPageData.cb_gpu_mux_mode(1); }
                        }
                    }
                }
            }

            // Battery & Display Section (Grouped for space)
            HorizontalLayout {
                spacing: RogTheme.spacing-lg;

                // Battery Section
                GlassCard {
                    horizontal-stretch: 1;
                    title: "Battery Health";
                    accent-color: RogTheme.accent-green;

                    VerticalLayout {
                        spacing: RogTheme.spacing-md;

                        HorizontalLayout {
                            Text {
                                text: "Charge Limit";
                                font-size: RogTheme.font-size-body;
                                vertical-alignment: center;
                                color: RogTheme.text-primary;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            GlassToggle {
                                checked: SystemPageData.charge_control_enabled;
                                accent-color: RogTheme.accent-green;
                                toggled(enabled) => {
                                    SystemPageData.charge_control_enabled = enabled;
                                    if enabled {
                                        SystemPageData.cb_charge_control_end_threshold(80);
                                    } else {
                                        SystemPageData.cb_charge_control_end_threshold(100);
                                    }
                                }
                            }
                        }

                        if SystemPageData.charge_control_enabled: GamingSlider {
                            label: "Limit Threshold";
                            unit: "%";
                            minimum: 40;
                            maximum: 80;
                            value: SystemPageData.charge_control_end_threshold;
                            changed(val) => {
                                SystemPageData.charge_control_end_threshold = val;
                                SystemPageData.cb_charge_control_end_threshold(val);
                            }
                        }
                    }
                }

                // Display Section
                GlassCard {
                    horizontal-stretch: 1;
                    title: "Display";
                    accent-color: RogTheme.accent-cyan;

                    VerticalLayout {
                        spacing: RogTheme.spacing-md;

                        HorizontalLayout {
                            Text {
                                text: "Panel Overdrive";
                                font-size: RogTheme.font-size-body;
                                vertical-alignment: center;
                                color: RogTheme.text-primary;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            GlassToggle {
                                checked: SystemPageData.panel_od;
                                accent-color: RogTheme.accent-cyan;
                                toggled(enabled) => {
                                    SystemPageData.panel_od = enabled;
                                    SystemPageData.cb_panel_od(enabled);
                                }
                            }
                        }

                        Text {
                            text: "Improves pixel response time but may cause visual artifacts.";
                            font-size: RogTheme.font-size-xs;
                            color: RogTheme.text-tertiary;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
