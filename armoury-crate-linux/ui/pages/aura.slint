// Aura RGB control page - Master-Detail Split Layout
// Redesigned to match Windows Armoury Crate "Aura Effects" style

import { RogTheme } from "../theme.slint";
import { ColorWheel } from "../widgets/color_wheel.slint";
import { KeyboardPreview } from "../widgets/keyboard_preview.slint";
import { GlassCard, GlassButton, TickSlider } from "../widgets/glass_card.slint";

// Aura page data bindings
export global AuraPageData {
    in-out property <bool> aura_available: false;

    // Brightness (0=Off, 1=Low, 2=Med, 3=High)
    in-out property <int> brightness: 2;
    callback cb_brightness(int);

    // LED mode (AuraModeNum values)
    in-out property <int> led_mode: 0;
    callback cb_led_mode(int);

    // LED speed (0=Low, 1=Med, 2=High)
    in-out property <int> led_speed: 1;
    callback cb_speed(int);

    // Color (RGB)
    in-out property <int> color_r: 255;
    in-out property <int> color_g: 0;
    in-out property <int> color_b: 85;
    callback cb_color(int, int, int);

    // HSV support for color wheel
    in-out property <float> color_hue: 0.0;
    in-out property <float> color_saturation: 1.0;
    in-out property <float> color_value: 1.0;
    callback cb_hsv_color(float, float, float);

    // Color presets
    in-out property <[color]> saved_presets: [#00000000, #00000000, #00000000, #00000000, #00000000, #00000000, #00000000, #00000000];
    in-out property <[bool]> preset_filled: [false, false, false, false, false, false, false, false];
    in-out property <int> selected_preset: -1;
    callback cb_save_preset(int);
    callback cb_load_preset(int);
    callback cb_delete_preset(int);

    // Mode enabled flags
    in-out property <[bool]> mode_enabled: [
        true, true, true, true,
        true, true, true, true,
        true, true, true, true,
        true
    ];
    in-out property <bool> is_loading: true;
    in-out property <string> error_message: "";

    // Helper to get mode name
    pure callback get_mode_name(int) -> string;
}

// Effect Selection Card
component EffectCard inherits Rectangle {
    in property <string> name;
    in property <string> icon-char: "●"; // Simple char icon
    in property <bool> selected: false;
    in property <bool> enabled: true;

    callback clicked();

    width: 100px;
    height: 100px;
    background: transparent;

    // Selection/Hover State
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: RogTheme.radius-md;
        background: selected ? RogTheme.bg-tertiary : (touch.has-hover && enabled ? RogTheme.bg-tertiary.with-alpha(0.5) : transparent);
        border-width: selected ? 1px : 0px;
        border-color: RogTheme.accent-red; // Red selection like reference

        animate background { duration: RogTheme.anim-fast; }
    }

    VerticalLayout {
        alignment: center;
        spacing: 8px;

        // Icon Circle
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: transparent;
            border-width: 2px;
            border-color: selected ? RogTheme.text-primary : RogTheme.text-secondary;

            Text {
                text: root.icon-char;
                font-size: 24px;
                color: selected ? RogTheme.text-primary : RogTheme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: name;
            font-size: 12px;
            color: selected ? RogTheme.text-primary : RogTheme.text-secondary;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Gradient Bar for Rainbow modes
component GradientBar inherits Rectangle {
    height: 20px;
    border-radius: 4px;
    background: @linear-gradient(90deg,
        #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);

    border-width: 1px;
    border-color: RogTheme.glass-border;
}

// Main Aura page
export component PageAura inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: RogTheme.spacing-lg;
        spacing: RogTheme.spacing-lg;

        // Header
        Text {
            text: "Aura Sync";
            font-size: RogTheme.font-size-h1;
            font-weight: 700;
            color: RogTheme.text-primary;
        }

        // Tab Bar (Visual only for now matching ref)
        HorizontalLayout {
            spacing: RogTheme.spacing-xl;

            Rectangle {
                width: 120px;
                height: 32px;

                Text {
                    text: "Sync devices";
                    color: RogTheme.text-secondary;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                width: 120px;
                height: 32px;

                Text {
                    text: "Aura Effects";
                    color: RogTheme.text-primary;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                // Active Indicator
                Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    width: 100%;
                    background: RogTheme.accent-cyan; // Cyan highlight like reference
                }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        // Main Split Content
        HorizontalLayout {
            spacing: RogTheme.spacing-xl;

            // LEFT PANEL: Basic Effects Grid
            VerticalLayout {
                width: 60%;
                spacing: RogTheme.spacing-md;

                Text {
                    text: "■ Basic Effects";
                    color: RogTheme.accent-red;
                    font-size: RogTheme.font-size-body;
                    font-weight: 700;
                }

                // Grid of Effects
                // Row 1
                HorizontalLayout {
                    spacing: RogTheme.spacing-md;

                    EffectCard {
                        name: "Static";
                        icon-char: "◎";
                        selected: AuraPageData.led_mode == 0;
                        enabled: AuraPageData.mode_enabled[0];
                        clicked => { AuraPageData.led_mode = 0; AuraPageData.cb_led_mode(0); }
                    }
                    EffectCard {
                        name: "Breathing";
                        icon-char: "〰";
                        selected: AuraPageData.led_mode == 1;
                        enabled: AuraPageData.mode_enabled[1];
                        clicked => { AuraPageData.led_mode = 1; AuraPageData.cb_led_mode(1); }
                    }
                    EffectCard {
                        name: "Strobing";
                        icon-char: "✧";
                        selected: AuraPageData.led_mode == 12; // Flash/Strobe
                        enabled: AuraPageData.mode_enabled[12];
                        clicked => { AuraPageData.led_mode = 12; AuraPageData.cb_led_mode(12); }
                    }
                    EffectCard {
                        name: "Color Cycle";
                        icon-char: "⟳";
                        selected: AuraPageData.led_mode == 2;
                        enabled: AuraPageData.mode_enabled[2];
                        clicked => { AuraPageData.led_mode = 2; AuraPageData.cb_led_mode(2); }
                    }
                    EffectCard {
                        name: "Rainbow";
                        icon-char: "🌈";
                        selected: AuraPageData.led_mode == 3; // Wave/Rainbow
                        enabled: AuraPageData.mode_enabled[3];
                        clicked => { AuraPageData.led_mode = 3; AuraPageData.cb_led_mode(3); }
                    }
                }

                // Row 2
                HorizontalLayout {
                    spacing: RogTheme.spacing-md;

                    EffectCard {
                        name: "Starry Night";
                        icon-char: "✨";
                        selected: AuraPageData.led_mode == 4;
                        enabled: AuraPageData.mode_enabled[4];
                        clicked => { AuraPageData.led_mode = 4; AuraPageData.cb_led_mode(4); }
                    }
                    EffectCard {
                        name: "Music";
                        icon-char: "ılı";
                        selected: false; // Not supported yet?
                        enabled: false;
                    }
                    EffectCard {
                        name: "Smart";
                        icon-char: "⚙";
                        selected: false;
                        enabled: false;
                    }
                    EffectCard {
                        name: "Dark (Off)";
                        icon-char: "🚫";
                        selected: AuraPageData.brightness == 0;
                        clicked => { AuraPageData.brightness = 0; AuraPageData.cb_brightness(0); }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // Advanced Effects section (Placeholder)
                Text {
                    text: "■ Advanced Effects";
                    color: RogTheme.text-tertiary; // Dimmed
                    font-size: RogTheme.font-size-body;
                    font-weight: 700;
                }

                GlassCard {
                    height: 60px;
                    GlassButton {
                        text: "Aura Creator";
                        accent-color: RogTheme.text-secondary;
                        width: 100%;
                    }
                }
            }

            // RIGHT PANEL: Settings Panel
            // Only visible if brightness > 0 (not Dark/Off)
            if AuraPageData.brightness > 0 : GlassCard {
                horizontal-stretch: 1;
                // Background pattern similar to reference (diagonal lines) - simulated with solid color for now
                background: RogTheme.bg-tertiary.with-alpha(0.5);

                VerticalLayout {
                    spacing: RogTheme.spacing-lg;
                    padding: RogTheme.spacing-lg;

                    // Header: Selected Mode Name
                    Text {
                        text: AuraPageData.led_mode == 0 ? "Static" :
                              AuraPageData.led_mode == 1 ? "Breathing" :
                              AuraPageData.led_mode == 2 ? "Color Cycle" :
                              AuraPageData.led_mode == 3 ? "Rainbow" :
                              "Effect Settings";
                        font-size: RogTheme.font-size-h3;
                        font-weight: 700;
                        color: RogTheme.text-primary;
                    }

                    // Pattern / Color Control
                    // For Rainbow/Cycle: Show Gradient Bar
                    if AuraPageData.led_mode == 2 || AuraPageData.led_mode == 3 : VerticalLayout {
                        spacing: 8px;
                        Text { text: "Pattern"; color: RogTheme.text-secondary; }
                        GradientBar {}
                    }

                    // For Static/Breathing: Show Color Wheel
                    if AuraPageData.led_mode == 0 || AuraPageData.led_mode == 1 || AuraPageData.led_mode == 12 : VerticalLayout {
                        spacing: 8px;
                        Text { text: "Color"; color: RogTheme.text-secondary; }

                        Rectangle {
                            height: 200px;
                            ColorWheel {
                                width: 100%;
                                height: 100%;
                                red <=> AuraPageData.color_r;
                                green <=> AuraPageData.color_g;
                                blue <=> AuraPageData.color_b;
                                hue <=> AuraPageData.color_hue;
                                saturation <=> AuraPageData.color_saturation;
                                value <=> AuraPageData.color_value;

                                color_changed(r, g, b) => { AuraPageData.cb_color(r, g, b); }
                                hue_changed(h) => { AuraPageData.cb_hsv_color(h, AuraPageData.color_saturation, AuraPageData.color_value); }
                                sv_changed(s, v) => { AuraPageData.cb_hsv_color(AuraPageData.color_hue, s, v); }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    // LED Brightness Slider
                    TickSlider {
                        label: "LED Brightness";
                        minimum: 0;
                        maximum: 3;
                        ticks: 4; // 0, 1, 2, 3
                        show-labels: true;
                        value: AuraPageData.brightness;
                        changed(val) => {
                            AuraPageData.brightness = round(val);
                            AuraPageData.cb_brightness(round(val));
                        }
                    }

                    // Speed Slider (Hidden for Static)
                    if AuraPageData.led_mode != 0 : TickSlider {
                        label: "Speed";
                        minimum: 0;
                        maximum: 2;
                        ticks: 3; // Slow, Normal, Fast
                        show-labels: true;
                        value: AuraPageData.led_speed;
                        changed(val) => {
                            AuraPageData.led_speed = round(val);
                            AuraPageData.cb_speed(round(val));
                        }
                    }
                }
            }
        }
    }
}
