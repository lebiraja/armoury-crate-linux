// Aura RGB control page - Enhanced UI with color wheel, keyboard preview, and animated modes
// Gaming-styled controls for ASUS Aura keyboard lighting

import { RogTheme } from "../theme.slint";
import { ColorWheel, ColorPresetsRow } from "../widgets/color_wheel.slint";
import { KeyboardPreview } from "../widgets/keyboard_preview.slint";

// Aura page data bindings
export global AuraPageData {
    in-out property <bool> aura_available: false;

    // Brightness (0=Off, 1=Low, 2=Med, 3=High)
    in-out property <int> brightness: 2;
    callback cb_brightness(int);

    // LED mode (AuraModeNum values)
    in-out property <int> led_mode: 0;
    in-out property <[string]> available_modes: [
        "Static",      // 0
        "Breathe",     // 1
        "RainbowCycle", // 2
        "RainbowWave", // 3
        "Star",        // 4
        "Rain",        // 5
        "Highlight",   // 6
        "Laser",       // 7
        "Ripple",      // 8
        "Pulse",       // 10
        "Comet",       // 11
        "Flash"        // 12
    ];
    callback cb_led_mode(int);

    // LED speed (0=Low, 1=Med, 2=High)
    in-out property <int> led_speed: 1;
    callback cb_speed(int);

    // Color (RGB)
    in-out property <int> color_r: 255;
    in-out property <int> color_g: 0;
    in-out property <int> color_b: 85;
    callback cb_color(int, int, int);

    // HSV support for color wheel
    in-out property <float> color_hue: 0.0;
    in-out property <float> color_saturation: 1.0;
    in-out property <float> color_value: 1.0;
    callback cb_hsv_color(float, float, float);

    // Color presets
    in-out property <[color]> saved_presets: [#00000000, #00000000, #00000000, #00000000, #00000000, #00000000, #00000000, #00000000];
    in-out property <[bool]> preset_filled: [false, false, false, false, false, false, false, false];
    in-out property <int> selected_preset: -1;
    callback cb_save_preset(int);
    callback cb_load_preset(int);
    callback cb_delete_preset(int);

    // Mode enabled flags
    in-out property <[bool]> mode_enabled: [
        true, true, true, true,
        true, true, true, true,
        true, true, true, true,
        true
    ];
    in-out property <bool> is_loading: true;
    in-out property <string> error_message: "";
}

// Compact brightness button
component BrightnessBtn inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected: false;
    callback clicked();

    width: 56px;
    height: 48px;
    background: selected ? RogTheme.accent-cyan.with-alpha(0.2) : RogTheme.bg-card;
    border-radius: RogTheme.radius-md;
    border-width: selected ? 2px : 1px;
    border-color: selected ? RogTheme.accent-cyan : RogTheme.border-default;

    drop-shadow-color: selected ? RogTheme.accent-cyan.with-alpha(0.4) : #00000000;
    drop-shadow-blur: selected ? 10px : 0px;

    states [
        hover when touch.has-hover && !selected: {
            background: RogTheme.bg-hover;
            border-color: RogTheme.accent-cyan.with-alpha(0.5);
        }
    ]

    animate background, border-color { duration: RogTheme.anim-fast; }

    touch := TouchArea { clicked => { root.clicked(); } }

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: icon;
            font-size: 18px;
            horizontal-alignment: center;
        }

        Text {
            text: label;
            font-size: RogTheme.font-size-xs;
            font-weight: selected ? 600 : 400;
            color: selected ? RogTheme.accent-cyan : RogTheme.text-secondary;
            horizontal-alignment: center;
        }
    }
}

// Speed button component
component SpeedBtn inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected: false;
    callback clicked();

    width: 52px;
    height: 40px;
    background: selected ? RogTheme.accent-orange.with-alpha(0.2) : RogTheme.bg-card;
    border-radius: RogTheme.radius-sm;
    border-width: selected ? 2px : 1px;
    border-color: selected ? RogTheme.accent-orange : RogTheme.border-default;

    states [
        hover when touch.has-hover && !selected: {
            background: RogTheme.bg-hover;
        }
    ]

    animate background { duration: RogTheme.anim-fast; }

    touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;

        Text {
            text: icon;
            font-size: 14px;
            vertical-alignment: center;
        }

        Text {
            text: label;
            font-size: RogTheme.font-size-xs;
            font-weight: selected ? 600 : 400;
            color: selected ? RogTheme.accent-orange : RogTheme.text-secondary;
            vertical-alignment: center;
        }
    }
}

// Animated mode card (compact version)
component AnimatedModeCard inherits Rectangle {
    in property <string> name;
    in property <int> mode_id: 0;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <color> preview_color: RogTheme.accent-cyan;

    // Animation properties for different modes
    property <float> anim_phase: mod(animation-tick() / 1s, 1);
    property <float> anim_offset: 0;

    callback clicked();

    width: 80px;
    height: 65px;
    background: selected ? RogTheme.accent-purple.with-alpha(0.2) : (enabled ? RogTheme.bg-card : RogTheme.bg-tertiary);
    border-radius: RogTheme.radius-md;
    border-width: selected ? 2px : 1px;
    border-color: selected ? RogTheme.accent-purple : (enabled ? RogTheme.border-default : RogTheme.border-default.with-alpha(0.3));
    opacity: enabled ? 1.0 : 0.4;

    drop-shadow-color: selected ? RogTheme.accent-purple.with-alpha(0.5) : #00000000;
    drop-shadow-blur: selected ? 12px : 0px;

    states [
        hover when touch.has-hover && !selected && enabled: {
            background: RogTheme.bg-hover;
            border-color: RogTheme.accent-purple.with-alpha(0.5);
        }
    ]

    animate background, border-color, drop-shadow-blur { duration: RogTheme.anim-fast; }

    touch := TouchArea {
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        padding: 6px;

        // Animated preview area
        Rectangle {
            width: 56px;
            height: 22px;
            border-radius: 4px;
            clip: true;

            // Base color layer
            Rectangle {
                width: 100%;
                height: 100%;
                background: preview_color;

                // Animation overlays based on mode
                // Static (0) - no animation
                if mode_id == 0: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: preview_color;
                }

                // Breathe (1) - opacity pulse
                if mode_id == 1: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: preview_color;
                    opacity: 0.3 + 0.7 * (0.5 + 0.5 * cos(anim_phase * 360deg));
                }

                // Rainbow Cycle (2) - hue rotation
                if mode_id == 2: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: hsv(anim_phase * 360, 1, 1);
                }

                // Rainbow Wave (3) - horizontal rainbow gradient
                if mode_id == 3: Rectangle {
                    width: 200%;
                    height: 100%;
                    x: -anim_phase * parent.width;
                    background: @linear-gradient(90deg,
                        hsv(0, 1, 1) 0%,
                        hsv(60, 1, 1) 16%,
                        hsv(120, 1, 1) 33%,
                        hsv(180, 1, 1) 50%,
                        hsv(240, 1, 1) 66%,
                        hsv(300, 1, 1) 83%,
                        hsv(360, 1, 1) 100%
                    );
                }

                // Star (4) - twinkle effect
                if mode_id == 4: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: preview_color;
                    opacity: mod(anim_phase * 7, 1) > 0.5 ? 1.0 : 0.3;
                }

                // Rain (5) - vertical moving gradient
                if mode_id == 5: Rectangle {
                    width: 100%;
                    height: 200%;
                    y: (anim_phase - 1) * parent.height;
                    background: @linear-gradient(180deg,
                        transparent 0%,
                        preview_color 50%,
                        transparent 100%
                    );
                }

                // Highlight (6) - horizontal sweep
                if mode_id == 6: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: @linear-gradient(90deg,
                        preview_color.with-alpha(0.3) 0%,
                        preview_color 50%,
                        preview_color.with-alpha(0.3) 100%
                    );
                    x: (anim_phase - 0.5) * parent.width;
                }

                // Laser (7) - horizontal beam
                if mode_id == 7: Rectangle {
                    width: 20%;
                    height: 100%;
                    x: anim_phase * parent.width;
                    background: @linear-gradient(90deg,
                        transparent 0%,
                        preview_color 50%,
                        transparent 100%
                    );
                }

                // Ripple (8) - scale pulse from center
                if mode_id == 8: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: preview_color;
                    opacity: 1 - anim_phase;
                }

                // Pulse (10) - brightness pulse
                if mode_id == 10: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: preview_color;
                    opacity: anim_phase < 0.5 ? (anim_phase * 2) : (2 - anim_phase * 2);
                }

                // Comet (11) - moving streak
                if mode_id == 11: Rectangle {
                    width: 40%;
                    height: 100%;
                    x: anim_phase * parent.width * 1.5 - parent.width * 0.2;
                    background: @linear-gradient(90deg,
                        transparent 0%,
                        preview_color.with-alpha(0.5) 30%,
                        preview_color 100%
                    );
                }

                // Flash (12) - blink
                if mode_id == 12: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: preview_color;
                    opacity: mod(anim_phase * 4, 1) > 0.5 ? 1.0 : 0.0;
                }
            }
        }

        // Mode name
        Text {
            text: name;
            font-size: 10px;
            font-weight: selected ? 600 : 400;
            color: selected ? RogTheme.accent-purple : RogTheme.text-primary;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Quick color swatch
component QuickColor inherits Rectangle {
    in property <color> swatch_color;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: swatch_color;
    border-width: 2px;
    border-color: RogTheme.border-default;

    states [
        hover when touch.has-hover: {
            border-color: white;
            drop-shadow-blur: 8px;
        }
    ]

    drop-shadow-color: swatch_color.with-alpha(0.4);
    drop-shadow-blur: 0px;

    animate border-color, drop-shadow-blur { duration: RogTheme.anim-fast; }

    touch := TouchArea { clicked => { root.clicked(); } }
}

// Main Aura page
export component PageAura inherits Rectangle {
    background: #00000000;

    // Not available state
    if !AuraPageData.aura_available: Rectangle {
        VerticalLayout {
            alignment: center;
            spacing: RogTheme.spacing-md;

            Text {
                text: "🎨";
                font-size: 64px;
                horizontal-alignment: center;
            }

            Text {
                text: "Aura RGB Not Available";
                font-size: RogTheme.font-size-h2;
                color: RogTheme.text-secondary;
                horizontal-alignment: center;
            }

            Text {
                text: "No Aura-compatible keyboard detected";
                font-size: RogTheme.font-size-body;
                color: RogTheme.text-tertiary;
                horizontal-alignment: center;
            }
        }
    }

    if AuraPageData.aura_available: Rectangle {
        // Loading State
        if AuraPageData.is_loading: VerticalLayout {
            alignment: center;
            spacing: RogTheme.spacing-md;
            Text {
                text: "Loading Aura RGB...";
                font-size: RogTheme.font-size-h3;
                color: RogTheme.text-secondary;
                horizontal-alignment: center;
            }
        }

        // Error State
        if !AuraPageData.is_loading && AuraPageData.error_message != "": VerticalLayout {
            alignment: center;
            spacing: RogTheme.spacing-md;
            Text {
                text: AuraPageData.error_message;
                font-size: RogTheme.font-size-body;
                color: RogTheme.danger;
                horizontal-alignment: center;
            }
        }

        // Main Content
        if !AuraPageData.is_loading && AuraPageData.error_message == "": Flickable {
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                padding: RogTheme.spacing-md;
                spacing: RogTheme.spacing-md;

                // Header with title and brightness
                HorizontalLayout {
                    spacing: RogTheme.spacing-lg;
                    alignment: space-between;

                    Text {
                        text: "Aura RGB";
                        font-size: RogTheme.font-size-h1;
                        font-weight: 700;
                        color: RogTheme.text-primary;
                        vertical-alignment: center;
                    }

                    // Brightness controls (inline)
                    HorizontalLayout {
                        spacing: RogTheme.spacing-xs;

                        BrightnessBtn {
                            label: "Off";
                            icon: "🌑";
                            selected: AuraPageData.brightness == 0;
                            clicked => { AuraPageData.brightness = 0; AuraPageData.cb_brightness(0); }
                        }
                        BrightnessBtn {
                            label: "Low";
                            icon: "🌘";
                            selected: AuraPageData.brightness == 1;
                            clicked => { AuraPageData.brightness = 1; AuraPageData.cb_brightness(1); }
                        }
                        BrightnessBtn {
                            label: "Med";
                            icon: "🌗";
                            selected: AuraPageData.brightness == 2;
                            clicked => { AuraPageData.brightness = 2; AuraPageData.cb_brightness(2); }
                        }
                        BrightnessBtn {
                            label: "High";
                            icon: "🌕";
                            selected: AuraPageData.brightness == 3;
                            clicked => { AuraPageData.brightness = 3; AuraPageData.cb_brightness(3); }
                        }
                    }
                }

                // Keyboard Preview Section
                Rectangle {
                    background: RogTheme.bg-secondary;
                    border-radius: RogTheme.radius-lg;
                    border-width: 1px;
                    border-color: RogTheme.border-default;
                    height: 230px;

                    VerticalLayout {
                        padding: RogTheme.spacing-md;
                        spacing: RogTheme.spacing-sm;

                        Text {
                            text: "Keyboard Preview";
                            font-size: RogTheme.font-size-sm;
                            color: RogTheme.text-tertiary;
                        }

                        HorizontalLayout {
                            alignment: center;
                            KeyboardPreview {
                                key_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                            }
                        }
                    }
                }

                // LED Effects Section - Compact 2 rows
                Rectangle {
                    background: RogTheme.bg-secondary;
                    border-radius: RogTheme.radius-lg;
                    border-width: 1px;
                    border-color: RogTheme.border-default;

                    VerticalLayout {
                        padding: RogTheme.spacing-md;
                        spacing: RogTheme.spacing-sm;

                        HorizontalLayout {
                            Text {
                                text: "LED Effect";
                                font-size: RogTheme.font-size-lg;
                                font-weight: 600;
                                color: RogTheme.text-primary;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // Speed controls (inline)
                            if AuraPageData.led_mode > 0: HorizontalLayout {
                                spacing: RogTheme.spacing-xs;

                                Text {
                                    text: "Speed:";
                                    font-size: RogTheme.font-size-sm;
                                    color: RogTheme.text-tertiary;
                                    vertical-alignment: center;
                                }

                                SpeedBtn {
                                    label: "Slow";
                                    icon: "🐢";
                                    selected: AuraPageData.led_speed == 0;
                                    clicked => { AuraPageData.led_speed = 0; AuraPageData.cb_speed(0); }
                                }
                                SpeedBtn {
                                    label: "Med";
                                    icon: "⚡";
                                    selected: AuraPageData.led_speed == 1;
                                    clicked => { AuraPageData.led_speed = 1; AuraPageData.cb_speed(1); }
                                }
                                SpeedBtn {
                                    label: "Fast";
                                    icon: "🚀";
                                    selected: AuraPageData.led_speed == 2;
                                    clicked => { AuraPageData.led_speed = 2; AuraPageData.cb_speed(2); }
                                }
                            }
                        }

                        // Row 1: First 6 modes
                        HorizontalLayout {
                            spacing: RogTheme.spacing-xs;
                            alignment: center;

                            AnimatedModeCard {
                                name: "Static";
                                mode_id: 0;
                                enabled: AuraPageData.mode_enabled[0];
                                selected: AuraPageData.led_mode == 0;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 0; AuraPageData.cb_led_mode(0); }
                            }
                            AnimatedModeCard {
                                name: "Breathe";
                                mode_id: 1;
                                enabled: AuraPageData.mode_enabled[1];
                                selected: AuraPageData.led_mode == 1;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 1; AuraPageData.cb_led_mode(1); }
                            }
                            AnimatedModeCard {
                                name: "Rainbow";
                                mode_id: 2;
                                enabled: AuraPageData.mode_enabled[2];
                                selected: AuraPageData.led_mode == 2;
                                preview_color: RogTheme.accent-cyan;
                                clicked => { AuraPageData.led_mode = 2; AuraPageData.cb_led_mode(2); }
                            }
                            AnimatedModeCard {
                                name: "Wave";
                                mode_id: 3;
                                enabled: AuraPageData.mode_enabled[3];
                                selected: AuraPageData.led_mode == 3;
                                preview_color: RogTheme.accent-cyan;
                                clicked => { AuraPageData.led_mode = 3; AuraPageData.cb_led_mode(3); }
                            }
                            AnimatedModeCard {
                                name: "Star";
                                mode_id: 4;
                                enabled: AuraPageData.mode_enabled[4];
                                selected: AuraPageData.led_mode == 4;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 4; AuraPageData.cb_led_mode(4); }
                            }
                            AnimatedModeCard {
                                name: "Rain";
                                mode_id: 5;
                                enabled: AuraPageData.mode_enabled[5];
                                selected: AuraPageData.led_mode == 5;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 5; AuraPageData.cb_led_mode(5); }
                            }
                        }

                        // Row 2: Remaining 6 modes
                        HorizontalLayout {
                            spacing: RogTheme.spacing-xs;
                            alignment: center;

                            AnimatedModeCard {
                                name: "Highlight";
                                mode_id: 6;
                                enabled: AuraPageData.mode_enabled[6];
                                selected: AuraPageData.led_mode == 6;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 6; AuraPageData.cb_led_mode(6); }
                            }
                            AnimatedModeCard {
                                name: "Laser";
                                mode_id: 7;
                                enabled: AuraPageData.mode_enabled[7];
                                selected: AuraPageData.led_mode == 7;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 7; AuraPageData.cb_led_mode(7); }
                            }
                            AnimatedModeCard {
                                name: "Ripple";
                                mode_id: 8;
                                enabled: AuraPageData.mode_enabled[8];
                                selected: AuraPageData.led_mode == 8;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 8; AuraPageData.cb_led_mode(8); }
                            }
                            AnimatedModeCard {
                                name: "Pulse";
                                mode_id: 10;
                                enabled: AuraPageData.mode_enabled[10];
                                selected: AuraPageData.led_mode == 10;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 10; AuraPageData.cb_led_mode(10); }
                            }
                            AnimatedModeCard {
                                name: "Comet";
                                mode_id: 11;
                                enabled: AuraPageData.mode_enabled[11];
                                selected: AuraPageData.led_mode == 11;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 11; AuraPageData.cb_led_mode(11); }
                            }
                            AnimatedModeCard {
                                name: "Flash";
                                mode_id: 12;
                                enabled: AuraPageData.mode_enabled[12];
                                selected: AuraPageData.led_mode == 12;
                                preview_color: rgb(AuraPageData.color_r, AuraPageData.color_g, AuraPageData.color_b);
                                clicked => { AuraPageData.led_mode = 12; AuraPageData.cb_led_mode(12); }
                            }
                        }
                    }
                }

                // Color Section - Hide for Rainbow modes
                if AuraPageData.led_mode != 2 && AuraPageData.led_mode != 3: Rectangle {
                    background: RogTheme.bg-secondary;
                    border-radius: RogTheme.radius-lg;
                    border-width: 1px;
                    border-color: RogTheme.border-default;

                    VerticalLayout {
                        padding: RogTheme.spacing-md;
                        spacing: RogTheme.spacing-md;

                        Text {
                            text: "Color";
                            font-size: RogTheme.font-size-lg;
                            font-weight: 600;
                            color: RogTheme.text-primary;
                        }

                        HorizontalLayout {
                            spacing: RogTheme.spacing-lg;
                            alignment: center;

                            // HSV Color Wheel
                            ColorWheel {
                                red <=> AuraPageData.color_r;
                                green <=> AuraPageData.color_g;
                                blue <=> AuraPageData.color_b;
                                hue <=> AuraPageData.color_hue;
                                saturation <=> AuraPageData.color_saturation;
                                value <=> AuraPageData.color_value;

                                color_changed(r, g, b) => {
                                    AuraPageData.cb_color(r, g, b);
                                }

                                hue_changed(h) => {
                                    AuraPageData.cb_hsv_color(h, AuraPageData.color_saturation, AuraPageData.color_value);
                                }

                                sv_changed(s, v) => {
                                    AuraPageData.cb_hsv_color(AuraPageData.color_hue, s, v);
                                }
                            }
                        }

                        // Quick color presets
                        VerticalLayout {
                            spacing: RogTheme.spacing-xs;

                            Text {
                                text: "Quick Colors";
                                font-size: RogTheme.font-size-sm;
                                color: RogTheme.text-tertiary;
                            }

                            HorizontalLayout {
                                spacing: RogTheme.spacing-xs;
                                alignment: start;

                                QuickColor {
                                    swatch_color: #FF0055;
                                    clicked => { AuraPageData.color_r = 255; AuraPageData.color_g = 0; AuraPageData.color_b = 85; AuraPageData.cb_color(255, 0, 85); }
                                }
                                QuickColor {
                                    swatch_color: #00D9FF;
                                    clicked => { AuraPageData.color_r = 0; AuraPageData.color_g = 217; AuraPageData.color_b = 255; AuraPageData.cb_color(0, 217, 255); }
                                }
                                QuickColor {
                                    swatch_color: #B366FF;
                                    clicked => { AuraPageData.color_r = 179; AuraPageData.color_g = 102; AuraPageData.color_b = 255; AuraPageData.cb_color(179, 102, 255); }
                                }
                                QuickColor {
                                    swatch_color: #00FF66;
                                    clicked => { AuraPageData.color_r = 0; AuraPageData.color_g = 255; AuraPageData.color_b = 102; AuraPageData.cb_color(0, 255, 102); }
                                }
                                QuickColor {
                                    swatch_color: #FFAA00;
                                    clicked => { AuraPageData.color_r = 255; AuraPageData.color_g = 170; AuraPageData.color_b = 0; AuraPageData.cb_color(255, 170, 0); }
                                }
                                QuickColor {
                                    swatch_color: #FFFFFF;
                                    clicked => { AuraPageData.color_r = 255; AuraPageData.color_g = 255; AuraPageData.color_b = 255; AuraPageData.cb_color(255, 255, 255); }
                                }
                                QuickColor {
                                    swatch_color: #4444FF;
                                    clicked => { AuraPageData.color_r = 68; AuraPageData.color_g = 68; AuraPageData.color_b = 255; AuraPageData.cb_color(68, 68, 255); }
                                }
                                QuickColor {
                                    swatch_color: #FFFF00;
                                    clicked => { AuraPageData.color_r = 255; AuraPageData.color_g = 255; AuraPageData.color_b = 0; AuraPageData.cb_color(255, 255, 0); }
                                }
                                QuickColor {
                                    swatch_color: #FF66FF;
                                    clicked => { AuraPageData.color_r = 255; AuraPageData.color_g = 102; AuraPageData.color_b = 255; AuraPageData.cb_color(255, 102, 255); }
                                }
                                QuickColor {
                                    swatch_color: #00FFAA;
                                    clicked => { AuraPageData.color_r = 0; AuraPageData.color_g = 255; AuraPageData.color_b = 170; AuraPageData.cb_color(0, 255, 170); }
                                }
                            }
                        }

                        // Saved presets
                        ColorPresetsRow {
                            presets <=> AuraPageData.saved_presets;
                            preset_filled <=> AuraPageData.preset_filled;
                            selected_preset <=> AuraPageData.selected_preset;

                            preset_clicked(idx) => { AuraPageData.cb_load_preset(idx); }
                            save_preset(idx) => { AuraPageData.cb_save_preset(idx); }
                            delete_preset(idx) => { AuraPageData.cb_delete_preset(idx); }
                        }
                    }
                }
            }
        }
    }
}
