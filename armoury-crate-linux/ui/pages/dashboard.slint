// Dashboard page - Main monitoring view for Armoury Crate Linux
// Redesigned with glassmorphism and detailed metrics

import { RogTheme } from "../theme.slint";
import { GlassCard, GlassProgress } from "../widgets/glass_card.slint";
import { MetricCard, ProgressBar, InfoRow } from "../widgets/gauge.slint";
import { TempGraph } from "../widgets/temp_graph.slint";

// Dashboard data global - receives monitoring data from Rust
export global DashboardData {
    // CPU metrics
    in property <float> cpu-usage: 0;
    in property <float> cpu-temp: 0;
    in property <float> cpu-freq-ghz: 0;
    in property <[float]> cpu-temp-history: [];

    // GPU metrics
    in property <float> gpu-usage: 0;
    in property <float> gpu-temp: 0;
    in property <float> gpu-power-watts: 0;
    in property <float> gpu-freq-mhz: 0;
    in property <[float]> gpu-temp-history: [];

    // Memory metrics
    in property <float> ram-usage-percent: 0;
    in property <float> ram-total-gb: 0;
    in property <float> ram-used-gb: 0;

    // Storage metrics
    in property <float> disk-usage-percent: 0;
    in property <float> disk-total-gb: 0;
    in property <float> disk-used-gb: 0;

    // Fan and power
    in property <int> fan1-rpm: 0;
    in property <int> fan2-rpm: 0;
    in property <float> power-watts: 0;
    in property <float> battery-percent: 100;
    in property <bool> on-ac-power: true;

    // Current platform profile
    in property <string> platform-profile: "Balanced";
}

export component PageDashboard inherits Rectangle {
    background: transparent; // Uses main window background

    Flickable {
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            padding: RogTheme.spacing-lg;
            spacing: RogTheme.spacing-lg;

            // Header
            HorizontalLayout {
                spacing: RogTheme.spacing-md;

                Text {
                    text: "Dashboard";
                    font-size: RogTheme.font-size-h1;
                    font-weight: 700;
                    color: RogTheme.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Profile indicator (Glass style)
                Rectangle {
                    width: 180px;
                    height: 40px;
                    background: RogTheme.glass-bg;
                    border-radius: RogTheme.radius-md;
                    border-width: 1px;
                    border-color: RogTheme.glass-border;

                    HorizontalLayout {
                        padding-left: RogTheme.spacing-md;
                        padding-right: RogTheme.spacing-md;
                        spacing: RogTheme.spacing-sm;

                        Text {
                            text: "Profile:";
                            font-size: RogTheme.font-size-sm;
                            color: RogTheme.text-tertiary;
                            vertical-alignment: center;
                        }

                        Text {
                            text: DashboardData.platform-profile;
                            font-size: RogTheme.font-size-body;
                            font-weight: 600;
                            color: RogTheme.accent-cyan;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Top row - Main metrics
            HorizontalLayout {
                spacing: RogTheme.spacing-md;
                height: 220px;

                // CPU Card
                MetricCard {
                    horizontal-stretch: 1;
                    title: "CPU";
                    value: DashboardData.cpu-usage;
                    max-value: 100;
                    unit: "%";
                    subtitle: round(DashboardData.cpu-freq-ghz * 100) / 100 + " GHz";
                    accent-color: RogTheme.accent-cyan;
                }

                // GPU Card
                MetricCard {
                    horizontal-stretch: 1;
                    title: "GPU";
                    value: DashboardData.gpu-usage;
                    max-value: 100;
                    unit: "%";
                    subtitle: round(DashboardData.gpu-freq-mhz) + " MHz";
                    accent-color: RogTheme.accent-purple;
                }

                // Fans & Power Card
                GlassCard {
                    horizontal-stretch: 1;
                    title: "Fans & Power";
                    accent-color: RogTheme.accent-orange;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        InfoRow {
                            label: "CPU Fan";
                            value: DashboardData.fan1-rpm + " RPM";
                            value-color: DashboardData.fan1-rpm > 4000 ? RogTheme.warning : RogTheme.text-primary;
                        }

                        InfoRow {
                            label: "GPU Fan";
                            value: DashboardData.fan2-rpm + " RPM";
                            value-color: DashboardData.fan2-rpm > 4000 ? RogTheme.warning : RogTheme.text-primary;
                        }

                        Rectangle { height: 8px; }

                        InfoRow {
                            label: "Power";
                            value: DashboardData.on-ac-power ? "AC Adapter" : round(DashboardData.battery-percent) + "% Battery";
                            value-color: DashboardData.on-ac-power ? RogTheme.success : RogTheme.accent-orange;
                        }

                        if DashboardData.power-watts > 0: InfoRow {
                            label: "Total Draw";
                            value: round(DashboardData.power-watts) + " W";
                            value-color: RogTheme.accent-cyan;
                        }
                    }
                }
            }

            // Middle row - Storage & Memory
            GlassCard {
                title: "Memory & Storage";
                accent-color: RogTheme.accent-green;

                VerticalLayout {
                    spacing: RogTheme.spacing-md;

                    // RAM
                    GlassProgress {
                        label: "RAM";
                        value: DashboardData.ram-usage-percent / 100;
                        value-text: round(DashboardData.ram-used-gb * 10) / 10 + " / " + round(DashboardData.ram-total-gb * 10) / 10 + " GB";
                        bar-color: RogTheme.accent-orange;
                    }

                    // Disk
                    GlassProgress {
                        label: "Disk";
                        value: DashboardData.disk-usage-percent / 100;
                        value-text: round(DashboardData.disk-used-gb * 10) / 10 + " / " + round(DashboardData.disk-total-gb * 10) / 10 + " GB";
                        bar-color: RogTheme.accent-purple;
                    }
                }
            }

            // Bottom row - Temperature Graphs
            HorizontalLayout {
                spacing: RogTheme.spacing-md;
                height: 200px;

                // CPU Temp
                GlassCard {
                    horizontal-stretch: 1;
                    title: "CPU Temperature";
                    accent-color: RogTheme.accent-cyan;

                    VerticalLayout {
                        spacing: RogTheme.spacing-sm;

                        Text {
                            text: round(DashboardData.cpu-temp) + "°C";
                            font-size: RogTheme.font-size-display;
                            font-weight: 700;
                            color: DashboardData.cpu-temp > 85 ? RogTheme.danger :
                                   DashboardData.cpu-temp > 70 ? RogTheme.warning : RogTheme.accent-cyan;
                            horizontal-alignment: center;
                        }

                        TempGraph {
                            history: DashboardData.cpu-temp-history;
                            line-color: RogTheme.accent-cyan;
                            max-temp: 100;
                        }
                    }
                }

                // GPU Temp
                GlassCard {
                    horizontal-stretch: 1;
                    title: "GPU Temperature";
                    accent-color: RogTheme.accent-purple;

                    VerticalLayout {
                        spacing: RogTheme.spacing-sm;

                        Text {
                            text: round(DashboardData.gpu-temp) + "°C";
                            font-size: RogTheme.font-size-display;
                            font-weight: 700;
                            color: DashboardData.gpu-temp > 85 ? RogTheme.danger :
                                   DashboardData.gpu-temp > 70 ? RogTheme.warning : RogTheme.accent-purple;
                            horizontal-alignment: center;
                        }

                        TempGraph {
                            history: DashboardData.gpu-temp-history;
                            line-color: RogTheme.accent-purple;
                            max-temp: 100;
                        }
                    }
                }
            }
        }
    }
}
