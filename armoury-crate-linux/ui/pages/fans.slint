// Fan curves page - Custom fan control
// Redesigned with glassmorphism styling

import { RogTheme } from "../theme.slint";
import { Graph, Node } from "../widgets/graph.slint";
import { GlassCard, GlassToggle, GlassButton } from "../widgets/glass_card.slint";

// Re-export Node for Rust code
export { Node }

// Fan curve point structure (legacy, kept for compatibility)
export struct FanCurvePoint {
    temp: int,
    pwm: int,
}

// Fans page data bindings
export global FansPageData {
    in-out property <bool> fans_available: false;

    // Selected profile (0=Balanced, 1=Performance, 2=Quiet)
    in-out property <int> selected_profile: 0;

    // CPU fan - using Node for graph compatibility (x=temp, y=pwm*1px where pwm 0-255)
    in-out property <bool> cpu_fan_enabled: true;
    in-out property <[Node]> cpu_fan_curve_balanced: [
        { x: 20px, y: 0px },
        { x: 30px, y: 26px },
        { x: 40px, y: 51px },
        { x: 50px, y: 77px },
        { x: 60px, y: 128px },
        { x: 70px, y: 179px },
        { x: 80px, y: 230px },
        { x: 100px, y: 255px },
    ];
    in-out property <[Node]> cpu_fan_curve_performance: [
        { x: 20px, y: 51px },
        { x: 30px, y: 77px },
        { x: 40px, y: 102px },
        { x: 50px, y: 128px },
        { x: 60px, y: 179px },
        { x: 70px, y: 204px },
        { x: 80px, y: 230px },
        { x: 100px, y: 255px },
    ];
    in-out property <[Node]> cpu_fan_curve_quiet: [
        { x: 20px, y: 0px },
        { x: 30px, y: 0px },
        { x: 40px, y: 26px },
        { x: 50px, y: 51px },
        { x: 60px, y: 77px },
        { x: 70px, y: 128px },
        { x: 80px, y: 179px },
        { x: 100px, y: 230px },
    ];

    // GPU fan - using Node for graph compatibility
    in-out property <bool> gpu_fan_enabled: true;
    in-out property <[Node]> gpu_fan_curve_balanced: [
        { x: 20px, y: 0px },
        { x: 30px, y: 26px },
        { x: 40px, y: 51px },
        { x: 50px, y: 77px },
        { x: 60px, y: 128px },
        { x: 70px, y: 179px },
        { x: 80px, y: 230px },
        { x: 100px, y: 255px },
    ];
    in-out property <[Node]> gpu_fan_curve_performance: [
        { x: 20px, y: 51px },
        { x: 30px, y: 77px },
        { x: 40px, y: 102px },
        { x: 50px, y: 128px },
        { x: 60px, y: 179px },
        { x: 70px, y: 204px },
        { x: 80px, y: 230px },
        { x: 100px, y: 255px },
    ];
    in-out property <[Node]> gpu_fan_curve_quiet: [
        { x: 20px, y: 0px },
        { x: 30px, y: 0px },
        { x: 40px, y: 26px },
        { x: 50px, y: 51px },
        { x: 60px, y: 77px },
        { x: 70px, y: 128px },
        { x: 80px, y: 179px },
        { x: 100px, y: 230px },
    ];

    // Currently selected fan (0=CPU, 1=GPU)
    in-out property <int> selected_fan: 0;

    // Callbacks
    callback cb_apply_curves();
    callback cb_reset_defaults();
    callback cb_set_cpu_fan_enabled(bool);
    callback cb_set_gpu_fan_enabled(bool);
    callback cb_profile_changed(int);
}

// Profile tab button
component ProfileTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 40px;
    horizontal-stretch: 1;
    background: selected ? RogTheme.accent-cyan.with-alpha(0.2) : transparent;
    border-radius: RogTheme.radius-md;

    states [
        hover when touch.has-hover && !selected: {
            background: RogTheme.glass-bg-light;
        }
    ]

    animate background { duration: RogTheme.anim-fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: label;
        font-size: RogTheme.font-size-body;
        font-weight: selected ? 700 : 400;
        color: selected ? RogTheme.accent-cyan : RogTheme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Bottom indicator
    if selected: Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: RogTheme.accent-cyan;
        border-radius: 2px;
    }
}

// Fan tab button
component FanTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 120px;
    height: 48px;
    background: selected ? RogTheme.accent-red.with-alpha(0.2) : RogTheme.glass-bg;
    border-radius: RogTheme.radius-md;
    border-width: 2px;
    border-color: selected ? RogTheme.accent-red : RogTheme.glass-border;
    opacity: enabled ? 1.0 : 0.5;

    animate background, border-color { duration: RogTheme.anim-fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: label;
            font-size: RogTheme.font-size-body;
            font-weight: selected ? 700 : 400;
            color: selected ? RogTheme.accent-red : RogTheme.text-primary;
            horizontal-alignment: center;
        }

        Text {
            text: enabled ? "Enabled" : "Disabled";
            font-size: RogTheme.font-size-xs;
            color: enabled ? RogTheme.status-success : RogTheme.text-tertiary;
            horizontal-alignment: center;
        }
    }
}

// Main fans page
export component PageFans inherits Rectangle {
    background: transparent;

    if !FansPageData.fans_available: Rectangle {
        VerticalLayout {
            alignment: center;
            spacing: RogTheme.spacing-md;

            Text {
                text: "🌀";
                font-size: 64px;
                horizontal-alignment: center;
            }

            Text {
                text: "Fan Control Not Available";
                font-size: RogTheme.font-size-h2;
                color: RogTheme.text-secondary;
                horizontal-alignment: center;
            }

            Text {
                text: "Custom fan curves are not supported on this device";
                font-size: RogTheme.font-size-body;
                color: RogTheme.text-tertiary;
                horizontal-alignment: center;
            }
        }
    }

    if FansPageData.fans_available: VerticalLayout {
        padding: RogTheme.spacing-lg;
        spacing: RogTheme.spacing-lg;

        // Header
        HorizontalLayout {
            Text {
                text: "Fan Curves";
                font-size: RogTheme.font-size-h1;
                font-weight: 700;
                color: RogTheme.text-primary;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                spacing: RogTheme.spacing-sm;

                GlassButton {
                    text: "Reset";
                    accent-color: RogTheme.text-secondary;
                    clicked => { FansPageData.cb_reset_defaults(); }
                }

                GlassButton {
                    text: "Apply";
                    accent-color: RogTheme.accent-cyan;
                    selected: true;
                    clicked => { FansPageData.cb_apply_curves(); }
                }
            }
        }

        // Profile tabs (Glass Card)
        GlassCard {
            compact: true;
            height: 60px;

            HorizontalLayout {
                padding: RogTheme.spacing-xs;
                spacing: RogTheme.spacing-xs;

                ProfileTab {
                    label: "Balanced";
                    selected: FansPageData.selected_profile == 0;
                    clicked => { FansPageData.selected_profile = 0; FansPageData.cb_profile_changed(0); }
                }

                ProfileTab {
                    label: "Performance";
                    selected: FansPageData.selected_profile == 1;
                    clicked => { FansPageData.selected_profile = 1; FansPageData.cb_profile_changed(1); }
                }

                ProfileTab {
                    label: "Quiet";
                    selected: FansPageData.selected_profile == 2;
                    clicked => { FansPageData.selected_profile = 2; FansPageData.cb_profile_changed(2); }
                }
            }
        }

        // Fan selection and toggle
        HorizontalLayout {
            spacing: RogTheme.spacing-md;

            FanTab {
                label: "CPU Fan";
                selected: FansPageData.selected_fan == 0;
                enabled: FansPageData.cpu_fan_enabled;
                clicked => { FansPageData.selected_fan = 0; }
            }

            FanTab {
                label: "GPU Fan";
                selected: FansPageData.selected_fan == 1;
                enabled: FansPageData.gpu_fan_enabled;
                clicked => { FansPageData.selected_fan = 1; }
            }

            Rectangle { horizontal-stretch: 1; }

            // Enable/disable toggle for selected fan
            HorizontalLayout {
                spacing: RogTheme.spacing-sm;
                GlassCard {
                    compact: true;
                    HorizontalLayout {
                        spacing: RogTheme.spacing-md;
                        Text {
                            text: FansPageData.selected_fan == 0 ? "CPU Fan Control" : "GPU Fan Control";
                            font-size: RogTheme.font-size-body;
                            vertical-alignment: center;
                            color: RogTheme.text-primary;
                        }

                        GlassToggle {
                            checked: FansPageData.selected_fan == 0 ? FansPageData.cpu_fan_enabled : FansPageData.gpu_fan_enabled;
                            accent-color: RogTheme.accent-cyan;
                            toggled(enabled) => {
                                if FansPageData.selected_fan == 0 {
                                    FansPageData.cpu_fan_enabled = enabled;
                                    FansPageData.cb_set_cpu_fan_enabled(enabled);
                                } else {
                                    FansPageData.gpu_fan_enabled = enabled;
                                    FansPageData.cb_set_gpu_fan_enabled(enabled);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Fan curve graph - Interactive draggable curve editor
        GlassCard {
            vertical-stretch: 1;
            accent-color: FansPageData.selected_fan == 0 ? RogTheme.accent-cyan : RogTheme.accent-purple;

            // Select the correct curve based on profile and fan selection
            property <[Node]> current_curve:
                FansPageData.selected_fan == 0 ? (
                    FansPageData.selected_profile == 0 ? FansPageData.cpu_fan_curve_balanced :
                    FansPageData.selected_profile == 1 ? FansPageData.cpu_fan_curve_performance :
                    FansPageData.cpu_fan_curve_quiet
                ) : (
                    FansPageData.selected_profile == 0 ? FansPageData.gpu_fan_curve_balanced :
                    FansPageData.selected_profile == 1 ? FansPageData.gpu_fan_curve_performance :
                    FansPageData.gpu_fan_curve_quiet
                );

            Graph {
                width: 100%;
                height: 100%;
                nodes <=> parent.current_curve;
                node_min: { x: 0px, y: 0px };
                node_max: { x: 100px, y: 255px };
            }
        }

        // Info text
        Text {
            text: "Drag points to adjust fan speed at each temperature. Apply to save changes.";
            font-size: RogTheme.font-size-sm;
            color: RogTheme.text-tertiary;
            horizontal-alignment: center;
        }
    }
}
