// Settings page - Application configuration
// Redesigned with glassmorphism

import { RogTheme } from "../theme.slint";
import { GlassCard, GlassToggle, GlassButton, SectionHeader } from "../widgets/glass_card.slint";

// Settings data bindings
export global SettingsData {
    // Application settings
    in-out property <bool> run_in_background: true;
    in-out property <bool> startup_in_background: false;
    in-out property <bool> enable_tray_icon: true;
    in-out property <bool> start_fullscreen: false;

    // Notification settings
    in-out property <bool> notifications_enabled: true;
    in-out property <bool> notify_gpu_status: true;
    in-out property <bool> notify_profile_changes: true;
    in-out property <bool> notify_charging_status: true;

    // Monitoring settings
    in-out property <bool> monitoring_enabled: true;
    in-out property <int> update_interval_ms: 500;
    in-out property <bool> show_gpu_metrics: true;
    in-out property <bool> show_power_metrics: true;

    // Power commands
    in-out property <string> ac_command: "";
    in-out property <string> bat_command: "";

    // Callbacks
    callback cb_save_settings();
    callback cb_reset_defaults();
    callback cb_toggle_run_in_background(bool);
    callback cb_toggle_startup_in_background(bool);
    callback cb_toggle_tray_icon(bool);
    callback cb_toggle_notifications(bool);
    callback cb_toggle_notify_gpu(bool);
    callback cb_toggle_notify_profile(bool);
    callback cb_toggle_notify_charging(bool);
    callback cb_toggle_monitoring(bool);
    callback cb_set_update_interval(int);
    callback cb_set_ac_command(string);
    callback cb_set_bat_command(string);
}

// Settings Toggle Row
component SettingsToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in-out property <bool> checked;
    callback toggled(bool);

    height: 48px;
    background: transparent;

    HorizontalLayout {
        spacing: RogTheme.spacing-md;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: label;
                font-size: RogTheme.font-size-body;
                color: RogTheme.text-primary;
            }

            if description != "": Text {
                text: description;
                font-size: RogTheme.font-size-xs;
                color: RogTheme.text-tertiary;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        GlassToggle {
            checked <=> root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
}

// Settings Input Row
component SettingsInputRow inherits Rectangle {
    in property <string> label;
    in property <string> placeholder: "";
    in-out property <string> value;
    callback changed(string);

    height: 72px;
    background: transparent;

    VerticalLayout {
        spacing: RogTheme.spacing-sm;

        Text {
            text: label;
            font-size: RogTheme.font-size-body;
            color: RogTheme.text-primary;
        }

        Rectangle {
            height: 40px;
            background: RogTheme.bg-tertiary.with-alpha(0.5);
            border-radius: RogTheme.radius-md;
            border-width: 1px;
            border-color: input.has-focus ? RogTheme.accent-cyan : RogTheme.glass-border;

            input := TextInput {
                x: RogTheme.spacing-md;
                width: parent.width - RogTheme.spacing-md * 2;
                height: 100%;
                font-size: RogTheme.font-size-body;
                color: RogTheme.text-primary;
                text <=> value;
                vertical-alignment: center;

                accepted => { changed(self.text); }
                edited => { changed(self.text); }
            }
        }
    }
}

// Main settings page
export component PageSettings inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: RogTheme.spacing-lg;
        spacing: RogTheme.spacing-lg;

        // Header
        HorizontalLayout {
            Text {
                text: "Settings";
                font-size: RogTheme.font-size-h1;
                font-weight: 700;
                color: RogTheme.text-primary;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                spacing: RogTheme.spacing-sm;

                GlassButton {
                    text: "Reset Defaults";
                    accent-color: RogTheme.text-secondary;
                    clicked => { SettingsData.cb_reset_defaults(); }
                }

                GlassButton {
                    text: "Save";
                    accent-color: RogTheme.accent-cyan;
                    selected: true;
                    clicked => { SettingsData.cb_save_settings(); }
                }
            }
        }

        // Scrollable content
        Flickable {
            vertical-stretch: 1;
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                spacing: RogTheme.spacing-lg;
                padding-bottom: RogTheme.spacing-lg; // Bottom padding for scrolling

                // Application Settings
                SectionHeader { title: "Application"; icon: "🔧"; }

                GlassCard {
                    SettingsToggleRow {
                        label: "Run in Background";
                        description: "Keep running when window is closed";
                        checked <=> SettingsData.run_in_background;
                        toggled(v) => { SettingsData.cb_toggle_run_in_background(v); }
                    }

                    SettingsToggleRow {
                        label: "Start Minimized";
                        description: "Start hidden in system tray";
                        checked <=> SettingsData.startup_in_background;
                        toggled(v) => { SettingsData.cb_toggle_startup_in_background(v); }
                    }

                    SettingsToggleRow {
                        label: "Enable Tray Icon";
                        description: "Show icon in system tray";
                        checked <=> SettingsData.enable_tray_icon;
                        toggled(v) => { SettingsData.cb_toggle_tray_icon(v); }
                    }
                }

                // Notification Settings
                SectionHeader { title: "Notifications"; icon: "🔔"; }

                GlassCard {
                    SettingsToggleRow {
                        label: "Enable Notifications";
                        description: "Show system notifications";
                        checked <=> SettingsData.notifications_enabled;
                        toggled(v) => { SettingsData.cb_toggle_notifications(v); }
                    }

                    SettingsToggleRow {
                        label: "GPU Status";
                        description: "Notify when GPU status changes";
                        checked <=> SettingsData.notify_gpu_status;
                        toggled(v) => { SettingsData.cb_toggle_notify_gpu(v); }
                    }

                    SettingsToggleRow {
                        label: "Profile Changes";
                        description: "Notify when performance profile changes";
                        checked <=> SettingsData.notify_profile_changes;
                        toggled(v) => { SettingsData.cb_toggle_notify_profile(v); }
                    }

                    SettingsToggleRow {
                        label: "Charging Status";
                        description: "Notify when charging status changes";
                        checked <=> SettingsData.notify_charging_status;
                        toggled(v) => { SettingsData.cb_toggle_notify_charging(v); }
                    }
                }

                // Monitoring Settings
                SectionHeader { title: "Monitoring"; icon: "📊"; }

                GlassCard {
                    SettingsToggleRow {
                        label: "Enable Monitoring";
                        description: "Enable real-time system monitoring";
                        checked <=> SettingsData.monitoring_enabled;
                        toggled(v) => { SettingsData.cb_toggle_monitoring(v); }
                    }

                    SettingsToggleRow {
                        label: "Show GPU Metrics";
                        description: "Display GPU temperature and usage";
                        checked <=> SettingsData.show_gpu_metrics;
                        toggled(v) => { SettingsData.cb_toggle_notify_gpu(v); } // Reusing callback for now
                    }

                    SettingsToggleRow {
                        label: "Show Power Metrics";
                        description: "Display power consumption";
                        checked <=> SettingsData.show_power_metrics;
                        toggled(v) => { SettingsData.cb_toggle_notify_charging(v); } // Reusing callback for now
                    }
                }

                // Power Commands
                SectionHeader { title: "Power Commands"; icon: "⚡"; }

                GlassCard {
                    Text {
                        text: "Execute custom commands when power source changes";
                        font-size: RogTheme.font-size-sm;
                        color: RogTheme.text-tertiary;
                    }

                    SettingsInputRow {
                        label: "AC Power Command";
                        placeholder: "e.g., /path/to/script.sh";
                        value <=> SettingsData.ac_command;
                        changed(v) => { SettingsData.cb_set_ac_command(v); }
                    }

                    SettingsInputRow {
                        label: "Battery Command";
                        placeholder: "e.g., /path/to/script.sh";
                        value <=> SettingsData.bat_command;
                        changed(v) => { SettingsData.cb_set_bat_command(v); }
                    }
                }
            }
        }
    }
}
