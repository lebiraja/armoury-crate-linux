// Gaming-styled sidebar navigation for Armoury Crate Linux
// Redesigned with glassmorphism and grouped navigation

import { RogTheme } from "../theme.slint";

// Individual navigation item
export component SidebarItem inherits Rectangle {
    in property <string> label;
    // Icon property removed as requested
    in property <bool> is-selected: false;
    in property <bool> is-available: true;

    callback clicked();

    height: 44px; // Slightly more compact
    background: transparent;

    // Selection background/glass effect
    Rectangle {
        x: 4px;
        width: parent.width - 8px;
        height: 100%;
        border-radius: RogTheme.radius-md;
        background: is-selected ? RogTheme.accent-red.with-alpha(0.15) :
                    touch.has-hover && is-available ? RogTheme.bg-hover : transparent;
        border-width: is-selected ? 1px : 0px;
        border-color: RogTheme.accent-red.with-alpha(0.3);

        animate background, border-color { duration: RogTheme.anim-fast; }
    }

    // Left accent bar for selected item
    Rectangle {
        x: 0;
        y: 8px;
        width: is-selected ? 3px : 0px;
        height: parent.height - 16px;
        background: RogTheme.accent-red;
        border-radius: 2px;

        animate width { duration: RogTheme.anim-fast; }
    }

    HorizontalLayout {
        padding-left: RogTheme.spacing-xl; // Increased padding since icon is gone
        spacing: RogTheme.spacing-md;
        alignment: start;

        Text {
            text: label;
            color: is-selected ? RogTheme.text-primary :
                   is-available ? RogTheme.text-secondary : RogTheme.text-disabled;
            font-size: RogTheme.font-size-body;
            font-weight: is-selected ? RogTheme.font-weight-semibold : RogTheme.font-weight-normal;
            vertical-alignment: center;

            animate color { duration: RogTheme.anim-fast; }
        }
    }

    touch := TouchArea {
        enabled: is-available;
        mouse-cursor: is-available ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Group header text
component SidebarGroupHeader inherits Text {
    font-size: RogTheme.font-size-xs;
    font-weight: RogTheme.font-weight-bold;
    color: RogTheme.text-tertiary;
    letter-spacing: 1px;
    vertical-alignment: center;
}

// Main Sidebar Component
export component SidebarGaming inherits Rectangle {
    // Current active page index
    in-out property <int> current-item: 0;

    // Callbacks
    callback item-clicked(int);
    callback quit-clicked();

    width: RogTheme.sidebar-width;
    background: RogTheme.bg-secondary.with-alpha(0.8); // Semi-transparent base

    // Glass border on right
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: RogTheme.glass-border;
    }

    VerticalLayout {
        padding: RogTheme.spacing-md;
        spacing: RogTheme.spacing-xs;
        alignment: start;

        // Logo area
        Rectangle {
            height: 80px;

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: "ARMOURY";
                    font-size: RogTheme.font-size-h3;
                    font-weight: 900;
                    color: RogTheme.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: "CRATE LINUX";
                    font-size: RogTheme.font-size-xs;
                    font-weight: 700;
                    color: RogTheme.accent-red;
                    horizontal-alignment: center;
                    letter-spacing: 3px;
                }
            }
        }

        // Section: System
        VerticalLayout {
            spacing: 2px;
            padding-top: RogTheme.spacing-md;
            padding-bottom: RogTheme.spacing-md;

            HorizontalLayout {
                padding-left: RogTheme.spacing-lg;
                padding-bottom: RogTheme.spacing-xs;
                SidebarGroupHeader { text: "SYSTEM"; }
            }

            SidebarItem {
                label: "Dashboard";
                is-selected: current-item == 0;
                clicked => { root.item-clicked(0); }
            }

            SidebarItem {
                label: "System Control";
                is-selected: current-item == 1;
                clicked => { root.item-clicked(1); }
            }

            SidebarItem {
                label: "Fan Curves";
                is-selected: current-item == 2;
                clicked => { root.item-clicked(2); }
            }
        }

        // Section: Customization
        VerticalLayout {
            spacing: 2px;
            padding-bottom: RogTheme.spacing-md;

            HorizontalLayout {
                padding-left: RogTheme.spacing-lg;
                padding-bottom: RogTheme.spacing-xs;
                SidebarGroupHeader { text: "CUSTOMIZATION"; }
            }

            SidebarItem {
                label: "Aura RGB";
                is-selected: current-item == 3;
                clicked => { root.item-clicked(3); }
            }

            SidebarItem {
                label: "Scenario Profiles";
                is-selected: current-item == 4;
                is-available: true; // Placeholder but clickable
                clicked => { root.item-clicked(4); }
            }

            SidebarItem {
                label: "AniMe Matrix";
                is-selected: current-item == 5;
                is-available: true; // Placeholder
                clicked => { root.item-clicked(5); }
            }
        }

        // Section: Application
        VerticalLayout {
            spacing: 2px;

            HorizontalLayout {
                padding-left: RogTheme.spacing-lg;
                padding-bottom: RogTheme.spacing-xs;
                SidebarGroupHeader { text: "APPLICATION"; }
            }

            SidebarItem {
                label: "Settings";
                is-selected: current-item == 6;
                clicked => { root.item-clicked(6); }
            }

            SidebarItem {
                label: "About";
                is-selected: current-item == 7;
                clicked => { root.item-clicked(7); }
            }
        }

        // Spacer
        Rectangle { vertical-stretch: 1; }

        // Quit Button
        SidebarItem {
            label: "Quit App";
            is-selected: false;
            clicked => { root.quit-clicked(); }
        }
    }
}
