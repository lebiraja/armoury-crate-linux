// Gauge widget for displaying metrics as circular progress
// Updated with glassmorphism styling

import { RogTheme } from "../theme.slint";
import { GlassCard } from "glass_card.slint";

export component Gauge inherits Rectangle {
    in property <float> value: 50;
    in property <float> max-value: 100;
    in property <string> label: "CPU";
    in property <string> unit: "%";
    in property <color> gauge-color: RogTheme.accent-cyan;

    // Calculate percentage
    property <float> percentage: clamp(value / max-value, 0, 1);

    width: RogTheme.gauge-size;
    height: RogTheme.gauge-size;

    // Background circle
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        background: RogTheme.bg-tertiary.with-alpha(0.5);
        border-width: 8px;
        border-color: RogTheme.glass-border;
    }

    // Progress arc
    // Since Slint doesn't support easy arcs, we keep the ring visual
    inner-ring := Rectangle {
        property <length> inner-size: parent.width - 16px;
        x: (parent.width - self.inner-size) / 2;
        y: (parent.height - self.inner-size) / 2;
        width: self.inner-size;
        height: self.inner-size;
        border-radius: self.width / 2;
        border-width: 6px;
        border-color: gauge-color.with-alpha(0.3);
        background: transparent;
    }

    // Active segment indication (visual trick for now)
    // In a real implementation we might use an image or path

    // Glow effect when value is high
    glow := Rectangle {
        visible: percentage > 0.1;
        property <length> glow-size: parent.width - 8px;
        x: (parent.width - self.glow-size) / 2;
        y: (parent.height - self.glow-size) / 2;
        width: self.glow-size;
        height: self.glow-size;
        border-radius: self.width / 2;

        // Simulating a filled gauge with a colored circle that has varying opacity based on value
        background: gauge-color.with-alpha(0.1 + (percentage * 0.2));
        border-width: 2px;
        border-color: gauge-color.with-alpha(percentage);

        drop-shadow-color: gauge-color.with-alpha(0.4);
        drop-shadow-blur: percentage > 0.7 ? RogTheme.glow-radius : 0px;

        animate background, border-color, drop-shadow-blur { duration: RogTheme.anim-normal; }
    }

    // Center content
    VerticalLayout {
        alignment: center;

        Text {
            text: round(value) + unit;
            font-size: RogTheme.font-size-h2;
            font-weight: 700;
            color: gauge-color;
            horizontal-alignment: center;
        }

        Text {
            text: label;
            font-size: RogTheme.font-size-xs;
            color: RogTheme.text-tertiary;
            horizontal-alignment: center;
            letter-spacing: 1px;
        }
    }
}

// Metric card that contains a gauge and additional info
export component MetricCard inherits GlassCard {
    in property <float> value: 0;
    in property <float> max-value: 100;
    in property <string> unit: "%";
    in property <string> subtitle: "";

    // Override properties from GlassCard
    title: "Metric"; // Should be overridden
    accent-color: RogTheme.accent-cyan;

    VerticalLayout {
        alignment: center;
        spacing: RogTheme.spacing-md;

        Gauge {
            value: root.value;
            max-value: root.max-value;
            label: root.title; // Use title as label inside gauge too
            unit: root.unit;
            gauge-color: root.accent-color;
        }

        if subtitle != "": Text {
            text: subtitle;
            font-size: RogTheme.font-size-sm;
            color: RogTheme.text-secondary;
            horizontal-alignment: center;
        }
    }
}

// Simple horizontal bar for RAM, etc.
export component ProgressBar inherits Rectangle {
    in property <float> value: 50;
    in property <float> max-value: 100;
    in property <color> bar-color: RogTheme.accent-cyan;

    property <float> percentage: clamp(value / max-value, 0, 1);

    height: 8px;
    border-radius: 4px;
    background: RogTheme.bg-tertiary;
    border-width: 1px;
    border-color: RogTheme.glass-border;

    Rectangle {
        width: parent.width * percentage;
        height: 100%;
        border-radius: parent.border-radius;
        background: bar-color;

        drop-shadow-color: bar-color.with-alpha(0.5);
        drop-shadow-blur: 4px;

        animate width { duration: RogTheme.anim-normal; }
    }
}

// Info row for displaying a label and value
export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: RogTheme.text-primary;

    height: 24px;
    background: transparent;

    HorizontalLayout {
        spacing: RogTheme.spacing-md;

        Text {
            text: label;
            font-size: RogTheme.font-size-sm;
            color: RogTheme.text-secondary;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: root.value;
            font-size: RogTheme.font-size-sm;
            font-weight: 600;
            color: value-color;
            vertical-alignment: center;
        }
    }
}
