// Main Window for Armoury Crate Linux
// Gaming-focused control center for ASUS ROG laptops

import { RogTheme } from "theme.slint";
import { SidebarGaming } from "widgets/sidebar_gaming.slint";
import { PageDashboard, DashboardData } from "pages/dashboard.slint";
import { PageAbout } from "pages/about.slint";
import { PageSystem, SystemPageData } from "pages/system.slint";
import { PageAura, AuraPageData } from "pages/aura.slint";
import { PageFans, FansPageData, FanCurvePoint, Node } from "pages/fans.slint";
import { PageScenario, ScenarioData, ScenarioRuleSlint } from "pages/scenario.slint";
import { PageAnime, AnimePageData } from "pages/anime.slint";
import { PageSettings, SettingsData } from "pages/settings.slint";

export { DashboardData, SystemPageData, AuraPageData, FansPageData, FanCurvePoint, Node, ScenarioData, ScenarioRuleSlint, AnimePageData, SettingsData }

export component MainWindow inherits Window {
    title: "Armoury Crate Linux";
    background: RogTheme.bg-primary;
    min-width: 1200px;
    min-height: 700px;
    preferred-width: 1280px;
    preferred-height: 800px;

    // Toast message state
    property <string> toast-message: "";
    property <bool> toast-visible: false;

    // Show toast notification
    public function show_toast(message: string) {
        toast-message = message;
        toast-visible = true;
        toast-timer.running = true;
    }

    // Timer to hide toast
    toast-timer := Timer {
        interval: 3000ms;
        running: false;
        triggered => {
            toast-visible = false;
            self.running = false;
        }
    }

    // Currently selected page
    property <int> current-page: 0;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // Sidebar navigation
            sidebar := SidebarGaming {
                current-item <=> current-page;

                item-clicked(idx) => {
                    current-page = idx;
                }

                quit-clicked => {
                    // Quit application
                    // Logic handled in Rust backend or simply close window
                }
            }

            // Main content area
            Rectangle {
                background: RogTheme.bg-primary;
                horizontal-stretch: 1;

                // Dashboard page (0)
                if current-page == 0: PageDashboard {
                    width: 100%;
                    height: 100%;
                }

                // System Control page (1)
                if current-page == 1: PageSystem {
                    width: 100%;
                    height: 100%;
                }

                // Fan Curves page (2)
                if current-page == 2: PageFans {
                    width: 100%;
                    height: 100%;
                }

                // Aura RGB page (3)
                if current-page == 3: PageAura {
                    width: 100%;
                    height: 100%;
                }

                // Scenario Profiles placeholder (4)
                if current-page == 4: Rectangle {
                    background: RogTheme.bg-primary;

                    VerticalLayout {
                        padding: RogTheme.spacing-lg;
                        alignment: center;

                        Text {
                            text: "Scenario Profiles";
                            font-size: RogTheme.font-size-h1;
                            font-weight: 700;
                            color: RogTheme.text-primary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Per-application automatic profile switching.\nComing soon!";
                            font-size: RogTheme.font-size-body;
                            color: RogTheme.text-secondary;
                            horizontal-alignment: center;
                        }
                    }
                }

                // AniMe Matrix placeholder (5)
                if current-page == 5: Rectangle {
                    background: RogTheme.bg-primary;

                    VerticalLayout {
                        padding: RogTheme.spacing-lg;
                        alignment: center;

                        Text {
                            text: "AniMe Matrix";
                            font-size: RogTheme.font-size-h1;
                            font-weight: 700;
                            color: RogTheme.text-primary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "AniMe Matrix display control.\nComing soon!";
                            font-size: RogTheme.font-size-body;
                            color: RogTheme.text-secondary;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Settings page (6)
                if current-page == 6: PageSettings {
                    width: 100%;
                    height: 100%;
                }

                // About page (7)
                if current-page == 7: PageAbout {
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Toast notification bar at bottom
        if toast-visible: Rectangle {
            height: 48px;
            background: RogTheme.bg-card;
            border-width: 1px;
            border-color: RogTheme.accent-cyan.with-alpha(0.3);

            HorizontalLayout {
                padding-left: RogTheme.spacing-lg;
                padding-right: RogTheme.spacing-lg;
                spacing: RogTheme.spacing-sm;
                alignment: center;

                Text {
                    text: "✓";
                    font-size: RogTheme.font-size-h3;
                    color: RogTheme.accent-cyan;
                    vertical-alignment: center;
                }

                Text {
                    text: toast-message;
                    font-size: RogTheme.font-size-body;
                    color: RogTheme.text-primary;
                    vertical-alignment: center;
                }
            }
        }
    }
}
